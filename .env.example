# Copia este archivo a .env y completa los valores.

# OBLIGATORIO. Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Conexión a PostgreSQL. Codifica los caracteres reservados del usuario o la clave en la URL.
# Ejemplo: postgresql+asyncpg://USUARIO:CLAVE@HOST:5432/municipio_conecta
# Sin .env ni DATABASE_URL, run.py prepara PostgreSQL local con Docker Compose.
DATABASE_URL=

# true muestra todo el SQL en consola (solo para depurar)
SQL_ECHO=false

# true crea usuarios y deudas de DEMOSTRACIÓN si la BD está vacía.
# Nunca lo actives en producción.
SEED_DEMO_DATA=false
# Contraseñas de los usuarios demo (solo si SEED_DEMO_DATA=true). Si las dejas vacías se generan al azar y se imprimen una vez.
DEMO_CITIZEN_PASSWORD=
DEMO_ADMIN_PASSWORD=
DEMO_STAFF_PASSWORD=

# Zona horaria usada para "hoy" en las estadísticas
APP_TIMEZONE=America/Lima

# Subida de documentos
UPLOADS_DIR=private_uploads
MAX_UPLOAD_MB=5

# Asistente IA (Google Gemini)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_REQUESTS_PER_MINUTE=10

# --- Pagos y comprobantes ---
# Mientras la pasarela sea simulada, deja MODO_DEMO=true (los PDF llevan marca "DEMOSTRACIÓN")
MODO_DEMO=true
GATEWAY_LATENCY_S=1.2
COMPROBANTE_SERIE=B001
# URL pública del sitio: se usa en el QR de verificación de los comprobantes
PUBLIC_BASE_URL=http://127.0.0.1:8000
MUNI_NOMBRE=Municipalidad de Chilca
MUNI_RUC=
MUNI_DIRECCION=Chilca, Junín - Perú
MUNI_TELEFONO=

# --- Plazos de atención (días hábiles) de quejas, reclamos y peticiones ---
PLAZO_QUEJA_DIAS=15
PLAZO_RECLAMO_DIAS=30
PLAZO_PETICION_DIAS=30
PLAZO_INFORMACION_DIAS=10
SOLICITUDES_POR_HORA=10

# --- Avisos por correo (opcional). Con cuenta Gmail/Outlook usa una "contraseña de aplicación", no tu clave normal ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# --- Avisos por WhatsApp con CallMeBot (opcional; solo escribe al número que lo activó: úsalo para avisos al personal) ---
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# --- Feriados adicionales a los nacionales (AAAA-MM-DD separados por coma), p. ej. locales ---
FERIADOS_EXTRA=
REGISTROS_POR_HORA=5
